<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Вход — NetAdmin</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>

<div class="auth">

  <!-- Left decorative panel -->
  <div class="auth__panel">
    <div class="auth__panel-logo">
      <div class="auth__panel-logo-icon">
        <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
      </div>
      <span class="auth__panel-logo-name">NetAdmin</span>
    </div>

    <div class="auth__panel-body">
      <h2 class="auth__panel-title">
        Управляйте<br>
        инфраструктурой<br>
        с единой точки
      </h2>
      <p class="auth__panel-desc">
        Полный контроль над сетевыми устройствами, мониторинг в реальном времени
        и гибкое управление доступом — всё в одной панели.
      </p>
    </div>

    <div class="auth__panel-dots">
      <div class="auth__panel-dot auth__panel-dot--active"></div>
      <div class="auth__panel-dot"></div>
      <div class="auth__panel-dot"></div>
    </div>
  </div>

  <!-- Right form panel -->
  <div class="auth__form-wrap">
    <div class="auth__box">

      <h1 class="auth__title">Добро пожаловать</h1>
      <p class="auth__subtitle">Войдите в свою учётную запись</p>

      <div class="field">
        <label class="field__label" for="email">E-mail</label>
        <div class="field__input-wrap">
          <span class="field__icon">
            <svg viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <input
            class="field__input"
            type="email"
            id="email"
            placeholder="admin@company.ru"
            autocomplete="email"
          >
        </div>
      </div>

      <div class="field">
        <div class="field-row">
          <label class="field__label" for="password">Пароль</label>
          <a href="pages/forgot.html" class="field-row__link">Забыли пароль?</a>
        </div>
        <div class="field__input-wrap">
          <span class="field__icon">
            <svg viewBox="0 0 24 24"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </span>
          <input
            class="field__input"
            type="password"
            id="password"
            placeholder="••••••••"
            autocomplete="current-password"
          >
          <button class="field__toggle" type="button" title="Показать пароль">
            <svg viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
          </button>
        </div>
      </div>

      <label class="check">
        <input class="check__input" type="checkbox" checked>
        <span class="check__label">Запомнить меня на этом устройстве</span>
      </label>

      <button class="btn btn--primary btn--full">
        Войти в систему
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>

      <div class="auth__divider">или</div>

      <button class="btn btn--ghost btn--full">
        <svg style="width:16px;height:16px;stroke:none;fill:#4285f4" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        Войти через Google
      </button>

      <p class="auth__hint">
        Нет учётной записи? <a href="#">Запросить доступ</a>
      </p>

    </div>
  </div>

</div>

</body>
</html>
