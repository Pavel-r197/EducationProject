<script>
  /* Profile dropdown toggle */
  function toggleProfile() {
    const menu = document.getElementById('profileMenu');
    menu.classList.toggle('profile-menu--open');
  }

  document.addEventListener('click', (e) => {
    const menu = document.getElementById('profileMenu');
    if (!menu.contains(e.target)) {
      menu.classList.remove('profile-menu--open');
    }
  });

  /* Pagination */
  document.querySelectorAll('.pagination__btn:not(.pagination__btn--nav)').forEach(btn => {
    btn.addEventListener('click', function () {
      document.querySelectorAll('.pagination__btn--active').forEach(b => b.classList.remove('pagination__btn--active'));
      this.classList.add('pagination__btn--active');
      const prev = document.querySelector('.pagination__btn--nav:first-of-type');
      const next = document.querySelector('.pagination__btn--nav:last-of-type');
      prev.disabled = this.textContent.trim() === '1';
      next.disabled = this.textContent.trim() === '25';
    });
  });

  /* Mobile sidebar */
  const menuToggle = document.getElementById('menu-toggle');
  const sidebar = document.getElementById('sidebar');
  if (window.innerWidth < 960) menuToggle.style.display = 'flex';
  menuToggle.addEventListener('click', () => sidebar.classList.toggle('sidebar--open'));
</script>

