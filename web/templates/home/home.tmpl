                    <button class="row-actions__btn" title="Редактировать"><svg viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                    <button class="row-actions__btn row-actions__btn--danger" title="Удалить"><svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
                  </div>
                </td>
              </tr>

              <tr class="table__tr">
                <td class="table__td"><input type="checkbox" class="table__checkbox"></td>
                <td class="table__td table__td--id">703</td>
                <td class="table__td"><span class="badge badge--switch">Коммутатор</span></td>
                <td class="table__td">ЦОД Москва · Стойка B-04</td>
                <td class="table__td">23.11.2021</td>
                <td class="table__td table__td--muted">10.03.2025, 14:05</td>
                <td class="table__td table__td--ip">10.0.2.250</td>
                <td class="table__td">Орлов Д.С.</td>
                <td class="table__td">
                  <div class="row-actions">
                    <button class="row-actions__btn" title="Просмотр"><svg viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg></button>
                    <button class="row-actions__btn" title="Редактировать"><svg viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                    <button class="row-actions__btn row-actions__btn--danger" title="Удалить"><svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
                  </div>
                </td>
              </tr>

              <tr class="table__tr">
                <td class="table__td"><input type="checkbox" class="table__checkbox"></td>
                <td class="table__td table__td--id">688</td>
                <td class="table__td"><span class="badge badge--camera">IP-камера</span></td>
                <td class="table__td">Склад · Зона В2</td>
                <td class="table__td">15.03.2022</td>
                <td class="table__td table__td--muted">09.03.2025, 08:30</td>
                <td class="table__td table__td--ip">172.16.10.45</td>
                <td class="table__td">Козлова Е.П.</td>
                <td class="table__td">
                  <div class="row-actions">
                    <button class="row-actions__btn" title="Просмотр"><svg viewBox="0 0 24 24"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg></button>
                    <button class="row-actions__btn" title="Редактировать"><svg viewBox="0 0 24 24"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg></button>
                    <button class="row-actions__btn row-actions__btn--danger" title="Удалить"><svg viewBox="0 0 24 24"><path d="M3 6h18M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg></button>
                  </div>
                </td>
              </tr>

              <tr class="table__tr">
                <td class="table__td"><input type="checkbox" class="table__checkbox"></td>
                <td class="table__td table__td--id">645</td>
                <td class="table__td"><span class="badge badge--workst">Рабочая станция</span></td>
                <td class="table__td">Офис Москва · Этаж 3</td>
                <td class="table__td">02.08.2023</td>
